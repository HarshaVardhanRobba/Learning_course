{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run db:generate -w @workspace/db",
    "db:migrate": "npm run db:migrate -w @workspace/db && npm run db:status -w @workspace/db",
    "db:status": "npm run db:status -w @workspace/db",
    "db:seed": "npm run db:seed -w @workspace/db"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.6",
    "@clerk/ui": "^1.44.2",
    "@iconify/react": "^6.0.4",
    "@neon/config": "^1.14.5",
    "@tanstack/react-query": "^5.108.2",
    "@trpc/client": "^11.29.7",
    "@trpc/server": "^11.29.7",
    "@trpc/tanstack-react-query": "^11.29.7",
    "@workspace/auth": "*",
    "@workspace/core": "*",
    "@workspace/db": "*",
    "@workspace/ui": "*",
    "client-only": "^0.0.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.77.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "superjson": "^2.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^10",
    "typescript": "^5"
  }
}
