{
  "name": "Learning-base",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:generate": "npm run db:generate -w @workspace/db",
    "db:migrate": "npm run db:migrate -w @workspace/db && npm run db:status -w @workspace/db",
    "db:status": "npm run db:status -w @workspace/db",
    "db:seed": "npm run db:seed -w @workspace/db"
  },
  "devDependencies": {
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
